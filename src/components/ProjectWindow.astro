---
const { title, url, content } = Astro.props;
---
<div class="p-10 gap-30 flex justify-center">
    <div class="rounded-xl bg-blue-100 p-3 sm:gap-2 md:gap-0 md:flex md:max-w-225">
        <div class="shrink-0">
            <img 
                class="h-0 aspect-1/1 sm:h-75 sm:w-full sm:object-cover md:h-full md:w-75" 
                src={url}
            />
        </div>
        <div class="p-3 text-[#4A474C]">
            <p class="font-extrabold text-5xl">{title}</p>
            <p class="font-semibold text-3xl">{content}</p>
        </div>
    </div>
    <div class="hidden xl:hidden xl:h-auto place-content-center">
        <div class="rounded-xl bg-[#71C5C7] place-content-center aspect-3/4 w-60 p-8">
            <div class="rounded-full bg-[#454247] aspect-1/1 w-45">
            </div>
        </div>
    </div>
</div>