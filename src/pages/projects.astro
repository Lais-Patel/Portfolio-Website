---
import "../styles/global.css";
import { getCollection} from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialButton from "../components/SocialButton.astro";
import { Image } from 'astro:assets';

const allProjects = await getCollection("project_content")
---

<BaseLayout pageTitle="Projects">
	<div class="flex p-10">
		<SocialButton title="Home" link="/" target="_self" icon="/favicon.svg"></SocialButton>
		<p class=" p-10 text-white/100 font-extrabold text-5xl"> Projects Page</p>
	</div>
	
	{ allProjects.map((project_content) => (
			
		<div class="flex flex-col items-center p-2">
			<a href={project_content.data.link} class="rounded-xl bg-[#1f1f1f] hover:bg-gray-500 w-2/3 p-5">
				<p class=" text-white/100 font-extrabold text-5xl">{project_content.data.title}</p>
				<p class=" text-white/100 font-thin text-4xl">{project_content.data.content}</p>
			</a>
		</div>	

	))}
	
</BaseLayout>